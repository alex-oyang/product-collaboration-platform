    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8"
